rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Merge this isolated namespace into existing project rules. Broad public wildcard
    // rules must not overlap this namespace, because Firestore allow rules are additive.
    match /sandesh_accounts/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }
  }
}
